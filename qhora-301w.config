CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_301w=y

# 核心驱动与网络支持 (针对 QHora-301W 双 10G Aquantia AQR113C 与 Wi-Fi 6)
CONFIG_PACKAGE_kmod-phy-aquantia=y
CONFIG_PACKAGE_ipq-wifi-qnap_301w=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# 存储与硬件支持 (eMMC, USB 3.0, 常见文件系统)
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_u-boot-envtools=y

# iStoreOS 核心交互与软件中心
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-nss-status=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_default-settings=y

# 内核精简与防变砖保护策略 (防止解压后超出原厂 U-Boot CONFIG_SYS_BOOTM_LEN 导致 inflate -5 变砖)
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_KERNEL is not set
CONFIG_STRIP_KERNEL_EXPORTS=y

#####################################################################
# NSS Offload 全功能栈 (qosmio nss-packages NSS-12.5-K6.x / Linux 6.6.141)
# 内核侧: include/kernel-6.6=6.6.141 + 06xx/017x 补丁 + ipq8074-nss.dtsi
# 说明: 原厂闭源 NSS 固件 blob 由 nss-firmware 包带入 (依赖 kmod-qca-nss-drv 自动安装)
#####################################################################
# 核心: NSS 驱动 + ECM 引擎 + 桥接/VLAN 管理器 + 多播/组播
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-mcs=y

# NSS 客户端 offload 模块 (PPPoE/L2TP/PPTP/GRE/VXLAN/IP隧道/Qdisc 等)
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y

# NSS 硬件加解密 / CFI / MACsec / 虚拟接口
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-cfi-cryptoapi=y
CONFIG_PACKAGE_kmod-qca-nss-macsec=y
CONFIG_PACKAGE_kmod-nss-ifb=y

# NSS SQM 智能队列 (bufferbloat 治理)
CONFIG_PACKAGE_sqm-scripts-nss=y

# ath11k WiFi offload 代码编译进内核，但运行时默认关闭 (nss_offload=0)
# 需要开启时: echo 'ath11k nss_offload=1 frame_mode=2' > /etc/modules.d/ath11k 后重启
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set

# NSS 固件版本: 11.4 Release 6 (兼容 802.11s mesh, 最稳定)
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
# CONFIG_NSS_FIRMWARE_VERSION_12_1 is not set
# CONFIG_NSS_FIRMWARE_VERSION_12_2 is not set
# CONFIG_NSS_FIRMWARE_VERSION_12_5 is not set

# 不将自定义 feed 写入镜像的 opkg 源列表 (避免固件内 opkg update 报错)
CONFIG_FEED_nss_packages=n
CONFIG_FEED_sqm_scripts_nss=n
