CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_301w=y

# 核心驱动与网络支持 (针对 QHora-301W 双 10G Aquantia AQR113C 与 Wi-Fi 6)
CONFIG_PACKAGE_kmod-phy-aquantia=y
CONFIG_PACKAGE_ipq-wifi-qnap_301w=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# 存储与硬件支持 (eMMC, USB 3.0, 常见文件系统)
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_u-boot-envtools=y

# iStoreOS 核心交互与软件中心
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_default-settings=y

# 内核精简与防变砖保护策略 (防止解压后超出原厂 U-Boot CONFIG_SYS_BOOTM_LEN 导致 inflate -5 变砖)
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_KERNEL is not set
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_PACKAGE_kmod-crypto-hw-qce=m
